FROM rocker/shiny:4.3.2

# System libraries required by httr2/curl and by AGD/plotly/rhandsontable's
# fork (fonts, TLS).
RUN apt-get update && apt-get install -y --no-install-recommends \
  libcurl4-gnutls-dev \
  libssl-dev \
  libuv1-dev \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN echo 'options(repos = c(CRAN = "https://cran.r-project.org"))' >> /usr/local/lib/R/etc/Rprofile.site
RUN R -e 'install.packages("remotes", repos="https://cran.r-project.org")'
RUN R -e 'install.packages(c(\
  "ggplot2", \
  "bsicons", \
  "plotly", \
  "shinyjs", \
  "htmltools", \
  "httr2" \
  ) , \
  repos="https://cran.r-project.org" \
  )'

# get github packages
COPY Renviron .Renviron
RUN R -e 'remotes::install_github("stefvanbuuren/rhandsontable")'
RUN R -e 'remotes::install_github("stefvanbuuren/AGD")'
RUN R -e 'install.packages(c("stringi", "stringr"), repos="https://cran.r-project.org")'
RUN R -e 'remotes::install_github("https://github.com/growthcharts/bdsmodels")'
RUN R -e 'remotes::install_github("https://github.com/growthcharts/tab10", ref = "jamesapp-integration")'
RUN rm .Renviron

ENV JAMES_BASE_URL=http://james

RUN rm -rf /srv/shiny-server/*
COPY /shiny srv/shiny-server/
RUN mv srv/shiny-server/app_james.R srv/shiny-server/app.R
